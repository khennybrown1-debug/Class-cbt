{
  "name": "cbt-practice-tests",
  "private": true,
  "description": "Optional developer tests. Students and the class admin do not need this folder.",
  "type": "module",
  "scripts": {
    "questions": "node ../tools/validate-questions.js",
    "engine": "node engine.test.cjs",
    "rules": "firebase emulators:exec --only firestore --project demo-cbt \"node rules.test.mjs\"",
    "e2e": "firebase emulators:exec --only firestore --project demo-cbt \"node e2e.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.12.2",
    "firebase-tools": "13.29.1",
    "tailwindcss": "3.4.17"
  }
}
